    .post-card { background: #fff; padding: 2rem; text-decoration: none; color: inherit; display: block; transition: background 0.15s; }
    .post-card:hover { background: var(--green-light); }
    .post-date { font-size: 12px; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px; }
    .post-card h2 { font-family: 'Instrument Serif', serif; font-size: 28px; font-weight: 400; letter-spacing: -0.5px; margin-bottom: 10px; }
    .post-excerpt { font-size: 15px; color: #555; line-height: 1.65; }

    article { padding-bottom: 5rem; }
    .article-meta { color: var(--muted); font-size: 14px; margin-bottom: 2rem; }
    article h1 { font-family: 'Instrument Serif', serif; font-size: clamp(32px, 5vw, 48px); letter-spacing: -1.5px; line-height: 1.1; font-weight: 400; margin-bottom: 1.5rem; }
    article h2 { font-family: 'Instrument Serif', serif; font-size: 28px; font-weight: 400; letter-spacing: -0.5px; margin: 2.5rem 0 1rem; }
    article p { font-size: 17px; line-height: 1.8; color: #333; margin-bottom: 1.25rem; }
    article a { color: var(--green-dark); font-weight: 600; }
    article ul, article ol { margin: 0 0 1.25rem 1.3rem; }
    article li { font-size: 17px; line-height: 1.8; color: #333; margin-bottom: 0.5rem; }
    .back-link { display: inline-block; margin-top: 1rem; color: var(--muted); text-decoration: none; font-size: 14px; }
    .back-link:hover { color: var(--text); }

    .inline-cta { background: var(--green-light); border: 1px solid var(--green); border-radius: var(--radius-sm); padding: 1.5rem 1.75rem; margin: 2rem 0; }
    .inline-cta p { margin: 0 0 12px; color: var(--green-dark); font-weight: 600; font-size: 16px; }
    .inline-cta a.btn-black { display: inline-block; }

    .btn-black { background: var(--text); color: var(--bg); border: none; padding: 12px 24px; border-radius: 100px; font-size: 14px; font-weight: 700; cursor: pointer; font-family: 'Cabinet Grotesk', sans-serif; text-decoration: none; transition: opacity 0.2s; }
