    @media (max-width: 680px) { nav { padding: 1rem 1.25rem; } .nav-links { display: none; } .wrap { padding: 0 1.25rem; } }

    .page-head { padding: 4rem 0 2.5rem; border-bottom: 1px solid var(--border); margin-bottom: 3rem; }
